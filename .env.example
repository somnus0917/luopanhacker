# Docker Compose 环境变量配置
# 复制此文件为 .env 并修改配置

# noVNC 远程桌面访问地址
# 部署时需要替换为服务器的真实 IP 或域名
NOVNC_URL=http://your-server-ip:6080

# 本机留空使用官方 Debian 源；腾讯云部署可设为 http://mirrors.cloud.tencent.com
DEBIAN_MIRROR=

# 首次初始化管理员时使用；必须设置为不少于 12 位且不等于 admin123 的密码
ADMIN_PASSWORD=

# 宿主机端口映射；公网部署前请同时配置防火墙或 HTTPS 反向代理
LUOPAN_HOST_BIND=127.0.0.1
LUOPAN_DASHBOARD_PORT=8501
LUOPAN_NOVNC_PORT=6080

# Rust API 直接提供登录、静态前端和业务接口
LUOPAN_API_RS_HOST=0.0.0.0
LUOPAN_API_RS_STORAGE_READS=true

# 生产环境必须通过 HTTPS 反向代理访问，并保持 Secure Cookie 开启。
SESSION_COOKIE_SECURE=true
# 多域名部署时用逗号列出受信任来源，例如 https://dashboard.example.com
LUOPAN_TRUSTED_ORIGINS=

# 独立采集服务通过共享任务队列调用 Rust worker，再启动 Python Playwright 模块
COLLECTION_WORKER_COMMAND=luopan-worker-rs compass-collect
STATUS_UPDATE_COMMAND=luopan-worker-rs status-update
SCHEDULED_SCRAPE_RUST_WORKER=true

# Rust SQLite storage：默认启用同步和优先读取
LUOPAN_STORAGE_DB=/app/state/luopan.db
STORAGE_SYNC_AFTER_SCRAPE=true
